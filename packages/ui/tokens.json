    "$type": "dimension",
    "$description": "Ten steps on a 4px base, for gap and padding.",
    "s1": {
      "$value": "4px"
    },
    "s2": {
      "$value": "8px"
    },
    "s3": {
      "$value": "12px"
    },
    "s4": {
      "$value": "16px"
    },
    "s5": {
      "$value": "20px"
    },
    "s6": {
      "$value": "24px"
    },
    "s8": {
      "$value": "32px"
    },
    "s10": {
      "$value": "40px"
    },
    "s12": {
      "$value": "48px"
    },
    "s16": {
      "$value": "64px"
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Three radii and a circle. Nothing is a pill.",
    "tight": {
      "$value": "6px",
      "$description": "Small controls over artwork: card tools, copy chips, tags",
      "$host": "var(--border-radius-sm, $)"
    },
    "control": {
      "$value": "10px",
      "$description": "Buttons, inputs, links, tiles, code blocks, menu rows",
      "$host": "var(--border-radius-lg, $)"
    },
    "surface": {
      "$value": "14px",
      "$description": "Panes, sheets, cards, menus and notes",
      "$host": "var(--border-radius-xl, $)"
    },
    "circle": {
      "$value": "999px",
      "$description": "Circles only: the avatar, tag coins, a rail's handles",
      "$host": "var(--border-radius-full, $)"
    }
  },
  "font": {
    "$description": "Words in Poppins, values in the system stack, code in mono.",
    "sans": {
      "$type": "fontFamily",
      "$value": "\"Poppins\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
      "$description": "Poppins, the only loaded face: everything written",
      "$host": "var(--font-sans, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif)"
    },
    "system": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "$description": "Digits that carry a value, and the line under a heading",
      "$host": "var(--font-sans, $)"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
      "$description": "Code, hex, seeds and token values",
      "$host": "var(--font-mono, $)"
    },
    "medium": {
      "$type": "fontWeight",
      "$value": "500",
      "$host": "var(--font-weight-normal, $)"
    },
    "bold": {
      "$type": "fontWeight",
      "$value": "700",
      "$host": "var(--font-weight-semibold, $)"
    },
    "fs0": {
      "$type": "dimension",
      "$value": "10.5px",
      "$description": "Chips and field labels"
