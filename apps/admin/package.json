{
  "name": "admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/app.css -o dist/styles.css --minify",
    "build": "pnpm build:css",
    "dev": "pnpm build && wrangler dev --port 3002",
    "migrate:remote": "wrangler d1 migrations apply grabient-admin --remote",
    "deploy": "pnpm build && pnpm migrate:remote && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/charts": "^0.14.0",
    "agents": "0.20.1",
    "d3-scale": "^4.0.2",
    "hono": "^4.8.3",
    "jose": "^6.1.0",
    "markdown-it": "15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/d3-scale": "^4.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
