{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/app.css -o dist/styles.css --minify",
    "build": "pnpm build:css && vite build",
    "dev": "pnpm build && wrangler dev --port 3001",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.islands.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.2",
    "@repo/data-ops": "workspace:^",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-virtual": "^3.13.34",
    "hono": "^4.8.3",
    "posthog-js": "^1.308.0",
    "solid-js": "^1.9.14",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251202.0",
    "@tailwindcss/cli": "^4.3.3",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^2.1.9",
    "wrangler": "^4.112.0"
  }
}
