{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/app.css -o dist/styles.css --minify",
    "build": "pnpm build:css && vite build",
    "dev": "pnpm build && wrangler dev --env staging --port 3001",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "deploy:production": "pnpm build && wrangler deploy --env production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.islands.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.3.2",
    "@repo/data-ops": "workspace:^",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-virtual": "^3.13.34",
    "better-auth": "^1.6.23",
    "hono": "^4.8.3",
    "posthog-js": "^1.308.0",
    "solid-js": "^1.9.14",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@tailwindcss/cli": "^4.3.3",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^3.2.4",
    "wrangler": "^4.112.0"
  }
}
